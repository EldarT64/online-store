# Порт, на котором приложение доступно на хосте (http://localhost:8080), только без docker-compose.prod.yml
APP_PORT=8080
# Секрет для подписи JWT (обязательно). Сгенерировать: openssl rand -hex 32
JWT_SECRET=
# Домен для HTTPS (только для docker-compose.prod.yml), DNS A-запись должна указывать на сервер
DOMAIN=
